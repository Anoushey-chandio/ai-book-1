# Node.js and Docusaurus related ignores
node_modules/
build/
dist/
.docusaurus/
.cache-loader/
*.log
.env*

# Git related ignores (often covered by .gitignore, but good for isolated publishing)
.git/

# Package manager specific ignores
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
